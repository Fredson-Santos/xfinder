# Configurações do Servidor XFinder (Go Engine)
PORT=2332
HOST=0.0.0.0
DATA_DIR=./data
WEB_DIR=./web

# Configurações do Telegram MTProto
TELEGRAM_API_ID=seu_api_id
TELEGRAM_API_HASH=seu_api_hash

# Canal do Telegram que envia os arquivos e listas
# Pode ser @nomedocanal (ex: @meucanal), link (https://t.me/meucanal) ou ID numérico (-100...)
TELEGRAM_CHANNEL=@seu_canal

# Configurações da API do XFinder para o Bot
XFINDER_API_URL=http://localhost:2332/api

# Sincronização imediata (baixa canais, filmes e séries assim que a lista é adicionada)
AUTO_SYNC=true

# Descartar e remover da base se a lista falhar na conexão ou estiver expirada
DELETE_ON_ERROR=true
