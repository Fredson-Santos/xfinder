{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XFinder",
  "version": "0.1.0",
  "identifier": "com.xfinder.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx -y serve -p 1420 -s .",
    "frontendDist": "./"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XFinder",
        "width": 960,
        "height": 720,
        "minWidth": 420,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
